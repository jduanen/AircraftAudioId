[Unit]
Description=Standalone aircraft audio/ADS-B/GPS recording unit
After=network.target gpsd.service chronyd.service
# recordings/ lives on the micro-SD (SPI) card, mounted via /etc/fstab — wait
# for that mount rather than starting and writing into the underlying eMMC
# root filesystem if the card isn't up yet.
RequiresMountsFor=/home/jdn/Code/AircraftAudioId/recordings

[Service]
Type=simple
User=jdn
Group=jdn
WorkingDirectory=/home/jdn/Code/AircraftAudioId
# Python fully-buffers stdout when it isn't a TTY (always the case under
# systemd) — without this, the recorder's print() diagnostics (GPS fix
# wait, observer position, save events, etc.) can sit in the buffer
# indefinitely instead of reaching `journalctl` promptly.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jdn/Code/AircraftAudioId/standaloneUnit/venv/bin/python \
    /home/jdn/Code/AircraftAudioId/scripts/standaloneRecord.py \
    --outputDir /home/jdn/Code/AircraftAudioId/recordings \
    --radiusKm 3 \
    --readsbUrl http://localhost/data/aircraft.json \
    --faaDatabaseDir /home/jdn/Code/AircraftAudioId/data/ReleasableAircraft \
    --ledChip gpiochip0 --ledLine 11 \
    --minFreeGb 2 \
    --nullSampleInterval 210 --nullSampleDuration 15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
