/*
 * Device Tree overlay sketch: repurpose an unused UART's RTS/CTS pin as a
 * plain GPIO output, for the Standalone unit's status LED.
 *
 * The GPS receiver occupies one of UART3/UART5 on the Ochin CM4 baseboard,
 * freeing up USART4's RTS4/CTS4 pins for other use. This overlay mux's the
 * chosen pin out of UART flow-control mode into plain GPIO output mode —
 * same pattern as cm4-sdspi.dts in audioCapture/AudioCap2.txt, which
 * repurposes GPIO18-21 from their default function for the SD-over-SPI
 * socket.
 *
 * brcm,pins is a PLACEHOLDER — the actual BCM GPIO number for RTS4/CTS4
 * on the Ochin baseboard needs to be confirmed against the CM4 schematic
 * during hardware bring-up (see ochin_CM4_topDoc.png), then StatusLed's
 * `--ledLine` should be set to match.
 *
 * Compile and install (same as cm4-sdspi.dts):
 *   sudo apt install -y device-tree-compiler
 *   dtc -@ -I dts -O dtb -o cm4-led-gpio.dtbo cm4-led-gpio.dts
 *   sudo install -m 0644 cm4-led-gpio.dtbo /boot/firmware/overlays/cm4-led-gpio.dtbo
 * Enable by adding to /boot/firmware/config.txt:
 *   dtoverlay=cm4-led-gpio
 */

/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target = <&gpio>;
        __overlay__ {
            led_gpio_pins: led_gpio_pins {
                brcm,pins = <TBD>;       /* BCM GPIO number for the freed RTS4/CTS4 pin */
                brcm,function = <1>;     /* 1 = GPIO output */
            };
        };
    };
};
